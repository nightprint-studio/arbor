{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "picus_sql",
      "camelcase": "PicusSql",
      "scope": "source.sql",
      "path": ".",
      "file-types": ["sql", "pks", "pkb", "prc", "fnc", "trg"],
      "injection-regex": "^(sql|plsql|plpgsql)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0-only",
    "description": "Tree-sitter grammar for Picus — one permissive superset of Oracle and PostgreSQL SQL",
    "authors": [
      { "name": "Nightprint Studio" }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
