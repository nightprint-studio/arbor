<?xml version="1.0" encoding="UTF-8"?>
<!-- Version-gate cases for language level 11: var and lambda parameters yes; switch rules, text blocks, records, patterns, sealed no.
     Each Bad file uses a feature newer than 11 exactly once (javac reports a source-level error once per
     file and feature); each Ok file uses what 11 already allows. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.arbor.bennu.corpus</groupId>
    <artifactId>bennu-check-corpus</artifactId>
    <version>0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>corpus-java11</artifactId>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
  </properties>
</project>
