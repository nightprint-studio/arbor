<?xml version="1.0" encoding="UTF-8"?>
<!-- Version-gate cases for language level 17: records, sealed types and instanceof patterns yes; switch patterns, record patterns, case null no.
     Each Bad file uses a feature newer than 17 exactly once (javac reports a source-level error once per
     file and feature); each Ok file uses what 17 already allows. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.arbor.bennu.corpus</groupId>
    <artifactId>bennu-check-corpus</artifactId>
    <version>0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>corpus-java17</artifactId>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>
</project>
