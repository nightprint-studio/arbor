{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "jsp",
      "camelcase": "Jsp",
      "scope": "source.jsp",
      "path": ".",
      "file-types": ["jsp", "jspf", "tag", "tagx"],
      "injection-regex": "^jsp$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0-only",
    "description": "Tree-sitter grammar for JSP — Bennu Java-editor highlighter",
    "authors": [
      { "name": "Nightprint Studio" }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
