{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "merula",
      "camelcase": "Merula",
      "scope": "source.merula",
      "path": ".",
      "file-types": ["merula"],
      "injection-regex": "^merula$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0-only",
    "description": "Tree-sitter grammar for the merula music DSL",
    "authors": [
      { "name": "Nightprint Studio" }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false
  }
}
